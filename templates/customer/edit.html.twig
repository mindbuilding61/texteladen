{% extends 'base.html.twig' %}
{% block title %}{{ customer.id ? 'Kunde bearbeiten' : 'Neuer Kunde' }}{% endblock %}
{% block body %}
    <h1 class="h3 mb-4">{{ customer.id ? 'Kunde bearbeiten' : 'Neuer Kunde' }}</h1>
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-8">{{ form_row(form.name) }}</div>
                    <div class="col-md-8">{{ form_row(form.contactName) }}</div>
                    <div class="col-md-8">{{ form_row(form.street) }}</div>
                    <div class="col-md-3">{{ form_row(form.postalCode) }}</div>
                    <div class="col-md-5">{{ form_row(form.city) }}</div>
                    <div class="col-md-2">{{ form_row(form.country) }}</div>
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-md-6">{{ form_row(form.vatId) }}</div>
                    <div class="col-md-6">{{ form_row(form.leitwegId) }}</div>
                    <div class="col-md-6">{{ form_row(form.buyerReference) }}</div>
                    <div class="col-12">{{ form_row(form.notes) }}</div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary">Speichern</button>
                    <a href="{{ path('customer_list') }}" class="btn btn-outline-secondary">Abbrechen</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
