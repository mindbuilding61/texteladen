{% extends 'base.html.twig' %}
{% block title %}Kunden{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Kunden</h1>
        <a href="{{ path('customer_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Neuer Kunde</a>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Name</th><th>Ort</th><th>E-Mail</th><th>USt-IdNr.</th><th>Leitweg-ID</th><th></th></tr>
                </thead>
                <tbody>
                    {% for c in customers %}
                        <tr>
                            <td><a href="{{ path('customer_edit', {id: c.id}) }}">{{ c.name }}</a></td>
                            <td>{{ c.postalCode }} {{ c.city }}</td>
                            <td>{{ c.email ?: '—' }}</td>
                            <td class="mono">{{ c.vatId ?: '—' }}</td>
                            <td class="mono">{{ c.leitwegId ?: '—' }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('customer_delete', {id: c.id}) }}" class="d-inline" onsubmit="return confirm('Diesen Kunden wirklich löschen?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('customer-delete-' ~ c.id) }}">
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-muted text-center py-4">Noch keine Kunden angelegt.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
