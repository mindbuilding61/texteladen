<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}E-Rechnung{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221em%22 font-size=%22110%22>📄</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
        <style>
            body { background: #f6f8fa; }
            .navbar-brand { font-weight: 600; letter-spacing: -.01em; }
            .table-sm td, .table-sm th { padding: .4rem .6rem; }
            .card { border: 1px solid #e5e7eb; }
            .status-badge { font-size: .75rem; text-transform: uppercase; letter-spacing: .03em; }
            .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .9em; }
            pre.xml { max-height: 420px; overflow: auto; background: #0f172a; color: #e2e8f0; padding: 1rem; border-radius: .5rem; font-size: .8em; }
            .num { text-align: right; font-variant-numeric: tabular-nums; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark">
            <div class="container-xl">
                <a class="navbar-brand" href="{{ path('dashboard') }}">📄 E-Rechnung</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link {{ app.request.get('_route') starts with 'incoming_' ? 'active' }}" href="{{ path('incoming_list') }}"><i class="bi bi-inbox"></i> Eingang</a></li>
                        <li class="nav-item"><a class="nav-link {{ app.request.get('_route') starts with 'outgoing_' ? 'active' }}" href="{{ path('outgoing_list') }}"><i class="bi bi-send"></i> Ausgang</a></li>
                        <li class="nav-item"><a class="nav-link {{ app.request.get('_route') starts with 'customer_' ? 'active' }}" href="{{ path('customer_list') }}"><i class="bi bi-people"></i> Kunden</a></li>
                        <li class="nav-item"><a class="nav-link {{ app.request.get('_route') starts with 'article_' ? 'active' }}" href="{{ path('article_list') }}"><i class="bi bi-tag"></i> Artikel</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link {{ app.request.get('_route') == 'settings_edit' ? 'active' }}" href="{{ path('settings_edit') }}"><i class="bi bi-gear"></i> Einstellungen</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container-xl py-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : (label == 'warning' ? 'warning' : 'info')) }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="container-xl text-center text-muted small py-4">
            E-Rechnung · XRechnung / ZUGFeRD · EN&nbsp;16931 · {{ 'now'|date('Y') }}
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
