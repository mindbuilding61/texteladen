{% extends 'base.html.twig' %}
{% block title %}{{ invoice.id ? 'Rechnung bearbeiten' : 'Neue Rechnung' }}{% endblock %}
{% block body %}
    <h1 class="h3 mb-3">{{ invoice.id ? 'Rechnung bearbeiten' : 'Neue Rechnung' }}</h1>

    {{ form_start(form) }}
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Rechnungskopf</div>
                <div class="card-body">
                    {{ form_row(form.customer) }}
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(form.issueDate) }}</div>
                        <div class="col-md-6">{{ form_row(form.dueDate) }}</div>
                        <div class="col-md-6">{{ form_row(form.servicePeriodStart) }}</div>
                        <div class="col-md-6">{{ form_row(form.servicePeriodEnd) }}</div>
                        <div class="col-md-6">{{ form_row(form.buyerReference) }}</div>
                        <div class="col-md-6">{{ form_row(form.leitwegId) }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Texte</div>
                <div class="card-body">
                    {{ form_row(form.introText) }}
                    {{ form_row(form.outroText) }}
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Positionen</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="add-line">
                <i class="bi bi-plus-lg"></i> Position hinzufügen
            </button>
        </div>
        <div class="card-body">
            <div id="lines" data-prototype="{{ form_widget(form.lines.vars.prototype)|e('html_attr') }}">
                {% for line in form.lines %}
                    <div class="row g-2 align-items-start mb-3 border-bottom pb-3 line-row">
                        <div class="col-md-4">{{ form_row(line.name) }}</div>
                        <div class="col-md-2">{{ form_row(line.quantity) }}</div>
                        <div class="col-md-2">{{ form_row(line.unit) }}</div>
                        <div class="col-md-3">{{ form_row(line.unitPrice) }}</div>
                        <div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger mt-4 remove-line"><i class="bi bi-trash"></i></button></div>
                        <div class="col-12">{{ form_row(line.description) }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary">Speichern</button>
        <a href="{{ path('outgoing_list') }}" class="btn btn-outline-secondary">Abbrechen</a>
    </div>
    {{ form_end(form) }}

    <script>
    (function() {
        const container = document.getElementById('lines');
        const addBtn = document.getElementById('add-line');
        let index = container.querySelectorAll('.line-row').length;

        function wireRemove(row) {
            row.querySelector('.remove-line').addEventListener('click', function() {
                row.remove();
            });
        }
        container.querySelectorAll('.line-row').forEach(wireRemove);

        addBtn.addEventListener('click', function() {
            const prototype = container.dataset.prototype.replace(/__name__/g, index++);
            const wrap = document.createElement('div');
            wrap.innerHTML = prototype;
            const inner = wrap.firstElementChild;
            inner.classList.add('line-row');
            inner.classList.add('row');
            inner.classList.add('g-2');
            inner.classList.add('align-items-start');
            inner.classList.add('mb-3');
            inner.classList.add('border-bottom');
            inner.classList.add('pb-3');
            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'btn btn-sm btn-outline-danger mt-2 remove-line';
            removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
            inner.appendChild(removeBtn);
            container.appendChild(inner);
            wireRemove(inner);
        });
    })();
    </script>
{% endblock %}
