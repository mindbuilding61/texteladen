{% extends 'base.html.twig' %}
{% block title %}{{ article.id ? 'Artikel bearbeiten' : 'Neuer Artikel' }}{% endblock %}
{% block body %}
    <h1 class="h3 mb-4">{{ article.id ? 'Artikel bearbeiten' : 'Neuer Artikel' }}</h1>
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-4">{{ form_row(form.sku) }}</div>
                    <div class="col-md-8">{{ form_row(form.name) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-md-4">{{ form_row(form.unitPrice) }}</div>
                    <div class="col-md-4">{{ form_row(form.unit) }}</div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary">Speichern</button>
                    <a href="{{ path('article_list') }}" class="btn btn-outline-secondary">Abbrechen</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
